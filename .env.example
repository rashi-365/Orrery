# Copy to .env (gitignored) and fill in. Never commit real keys.
RPC_URL=http://127.0.0.1:8545
# Deployer key. Also funds the simulator wallets. Local Anvil account 0 for local runs.
DEPLOYER_PRIVATE_KEY=
# Comma-separated keys for the swap simulator. Local Anvil only: the simulator refuses any other chain.
SIMULATOR_PRIVATE_KEYS=
