# Copy to web/.env.local (gitignored). Both values are public by design: they ship to the browser.
# Optional. Without it only browser wallets are offered. Get one from the WalletConnect (Reown) cloud dashboard.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# JSON-RPC URL of the local chain.
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
